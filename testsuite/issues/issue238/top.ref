
module sub_Brtl(a, b);
  inout a;
  wire a;
  output b;
  wire b;
  assign a = 1'hz;
  assign b = a;
endmodule

module top(a, c, b, d);
  inout a;
  wire a;
  inout c;
  wire c;
  output b;
  wire b;
  output d;
  wire d;
  wire _0_;
  sub_Brtl sub_inst (
    .a(a),
    .b(_0_)
  );
  assign c = 1'hz;
  assign b = _0_;
  assign d = c;
endmodule
